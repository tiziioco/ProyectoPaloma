USE medstock_db;

DELIMITER //

CREATE TRIGGER actualizar_stock_despues_de_toma
AFTER INSERT ON HISTORIAL_TOMAS
FOR EACH ROW
BEGIN
    -- Solo resta del inventario si el estado es 'Tomada'
    IF NEW.estado = 'Tomada' THEN
        UPDATE MEDICAMENTO M
        JOIN PROGRAMACION P ON M.id_medicamento = P.fk_id_medicamento
        SET M.stock_actual = M.stock_actual - P.dosis
        WHERE P.id_prog = NEW.fk_id_prog;
    END IF;
END //

DELIMITER ;




USE medstock_db;

DELIMITER //

CREATE TRIGGER calcular_proxima_toma
AFTER INSERT ON HISTORIAL_TOMAS
FOR EACH ROW
BEGIN
    UPDATE PROGRAMACION P
    SET P.proxima_toma = DATE_ADD(NEW.fecha_hora_confirmada, INTERVAL P.frecuencia_horas HOUR)
    WHERE P.id_prog = NEW.fk_id_prog;
END //

DELIMITER ;

USE medstock_db;

CREATE OR REPLACE VIEW vista_cumplimiento_pacientes AS
SELECT 
    U.nombre AS paciente,
    M.nombre_comercial AS medicamento,
    H.estado AS estado_toma,
    H.fecha_hora_confirmada
FROM HISTORIAL_TOMAS H
JOIN PROGRAMACION P ON H.fk_id_prog = P.id_prog
JOIN MEDICAMENTO M ON P.fk_id_medicamento = M.id_medicamento
JOIN USUARIO U ON M.fk_id_usuario = U.id_usuario;

USE medstock_db;


DROP PROCEDURE IF EXISTS registrar_compra_medicamento;

DELIMITER //

CREATE PROCEDURE registrar_compra_medicamento(
    IN p_id_medicamento INT,
    IN p_cantidad_comprada INT,
    IN p_nueva_fecha_vencimiento DATE
)
BEGIN
    UPDATE MEDICAMENTO
    SET stock_actual = stock_actual + p_cantidad_comprada,
        fecha_vencimiento = p_nueva_fecha_vencimiento
    WHERE id_medicamento = p_id_medicamento;
END //

DELIMITER ;

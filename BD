-- 1. SELECCIONAR LA BASE DE DATOS OFICIAL COMO MEDSTOCK
CREATE DATABASE IF NOT EXISTS medstock;
USE medstock;

-- 2. LIMPIAR TABLAS PREVIAS (Evita errores de duplicación)
DROP TABLE IF EXISTS HISTORIAL_TOMAS;
DROP TABLE IF EXISTS PROGRAMACION;
DROP TABLE IF EXISTS MEDICAMENTO;
DROP TABLE IF EXISTS USUARIO;

-- 3. CREACIÓN DE TABLAS ORIGINALES IMPECABLES
CREATE TABLE USUARIO (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    contrasenia VARCHAR(255) NOT NULL,
    rol VARCHAR(20) NOT NULL, 
    id_superior INT NULL,     
    FOREIGN KEY (id_superior) REFERENCES USUARIO(id_usuario) ON DELETE SET NULL
);

CREATE TABLE MEDICAMENTO (
    id_medicamento INT AUTO_INCREMENT PRIMARY KEY,
    nombre_comercial VARCHAR(100) NOT NULL,
    compuesto VARCHAR(100),
    presentacion VARCHAR(50) NOT NULL, 
    stock_actual INT NOT NULL,         
    stock_minimo INT NOT NULL,         
    fecha_vencimiento DATE,
    fk_id_usuario INT NOT NULL,        
    horario TIME NOT NULL, -- Columna clave para el cronómetro del abuelo
    FOREIGN KEY (fk_id_usuario) REFERENCES USUARIO(id_usuario) ON DELETE CASCADE
);

CREATE TABLE PROGRAMACION (
    id_prog INT AUTO_INCREMENT PRIMARY KEY,
    dosis INT NOT NULL,               
    frecuencia_horas INT NOT NULL,    
    proxima_toma DATETIME NOT NULL,   
    estado VARCHAR(20) DEFAULT 'Activo', 
    fk_id_medicamento INT NOT NULL,
    FOREIGN KEY (fk_id_medicamento) REFERENCES MEDICAMENTO(id_medicamento) ON DELETE CASCADE
);

CREATE TABLE HISTORIAL_TOMAS (
    id_registro INT AUTO_INCREMENT PRIMARY KEY,
    fecha_hora_confirmada DATETIME NOT NULL,
    estado VARCHAR(20) NOT NULL,      
    fk_id_prog INT NOT NULL,
    FOREIGN KEY (fk_id_prog) REFERENCES PROGRAMACION(id_prog) ON DELETE CASCADE
);

-- 4. TRIGGERS ORIGINALES AUTOMÁTICOS AL 100%
DELIMITER //
CREATE TRIGGER actualizar_stock_despues_de_toma
AFTER INSERT ON HISTORIAL_TOMAS
FOR EACH ROW
BEGIN
    IF NEW.estado = 'Tomada' THEN
        UPDATE MEDICAMENTO M
        JOIN PROGRAMACION P ON M.id_medicamento = P.fk_id_medicamento
        SET M.stock_actual = M.stock_actual - P.dosis
        WHERE P.id_prog = NEW.fk_id_prog;
    END IF;
END //
DELIMITER ;

DELIMITER //
CREATE TRIGGER calcular_proxima_toma
AFTER INSERT ON HISTORIAL_TOMAS
FOR EACH ROW
BEGIN
    UPDATE PROGRAMACION P
    SET P.proxima_toma = DATE_ADD(NEW.fecha_hora_confirmada, INTERVAL P.frecuencia_horas HOUR)
    WHERE P.id_prog = NEW.fk_id_prog;
END //
DELIMITER ;

-- 5. VISTAS Y PROCEDIMIENTOS ALMACENADOS
CREATE OR REPLACE VIEW vista_cumplimiento_pacientes AS
SELECT 
    U.nombre AS paciente,
    M.nombre_comercial AS medicamento,
    H.estado AS estado_toma,
    H.fecha_hora_confirmada
FROM HISTORIAL_TOMAS H
JOIN PROGRAMACION P ON H.fk_id_prog = P.id_prog
JOIN MEDICAMENTO M ON P.fk_id_medicamento = M.id_medicamento
JOIN USUARIO U ON M.fk_id_usuario = U.id_usuario;

DROP PROCEDURE IF EXISTS registrar_compra_medicamento;
DELIMITER //
CREATE PROCEDURE registrar_compra_medicamento(
    IN p_id_medicamento INT,
    IN p_cantidad_comprada INT,
    IN p_nueva_fecha_vencimiento DATE
)
BEGIN
    UPDATE MEDICAMENTO
    SET stock_actual = stock_actual + p_cantidad_comprada,
        fecha_vencimiento = p_nueva_fecha_vencimiento
    WHERE id_medicamento = p_id_medicamento;
END //
DELIMITER ;


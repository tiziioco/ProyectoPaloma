-- 1. SELECCIONAR LA BASE DE DATOS
CREATE DATABASE IF NOT EXISTS medstock_db;
USE medstock_db;

-- 2. LIMPIAR TABLAS PREVIAS (Para evitar el Error 1050)
DROP TABLE IF EXISTS HISTORIAL_TOMAS;
DROP TABLE IF EXISTS PROGRAMACION;
DROP TABLE IF EXISTS MEDICAMENTO;
DROP TABLE IF EXISTS USUARIO;

-- 3. CREACIÓN DE TABLAS
CREATE TABLE USUARIO (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    contrasenia VARCHAR(255) NOT NULL,
    rol VARCHAR(20) NOT NULL, 
    id_superior INT NULL,     
    FOREIGN KEY (id_superior) REFERENCES USUARIO(id_usuario) ON DELETE SET NULL
);

CREATE TABLE MEDICAMENTO (
    id_medicamento INT AUTO_INCREMENT PRIMARY KEY,
    nombre_comercial VARCHAR(100) NOT NULL,
    compuesto VARCHAR(100),
    presentacion VARCHAR(50) NOT NULL, 
    stock_actual INT NOT NULL,         
    stock_minimo INT NOT NULL,         
    fecha_vencimiento DATE,
    fk_id_usuario INT NOT NULL,        
    FOREIGN KEY (fk_id_usuario) REFERENCES USUARIO(id_usuario) ON DELETE CASCADE
);

CREATE TABLE PROGRAMACION (
    id_prog INT AUTO_INCREMENT PRIMARY KEY,
    dosis INT NOT NULL,               
    frecuencia_horas INT NOT NULL,    
    proxima_toma DATETIME NOT NULL,   
    estado VARCHAR(20) DEFAULT 'Activo', 
    fk_id_medicamento INT NOT NULL,
    FOREIGN KEY (fk_id_medicamento) REFERENCES MEDICAMENTO(id_medicamento) ON DELETE CASCADE
);

CREATE TABLE HISTORIAL_TOMAS (
    id_registro INT AUTO_INCREMENT PRIMARY KEY,
    fecha_hora_confirmada DATETIME NOT NULL,
    estado VARCHAR(20) NOT NULL,      
    fk_id_prog INT NOT NULL,
    FOREIGN KEY (fk_id_prog) REFERENCES PROGRAMACION(id_prog) ON DELETE CASCADE
);




